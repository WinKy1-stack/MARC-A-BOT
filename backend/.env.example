# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# OCR Configuration
USE_GPU=True
GPU_MEM=500
GPU_DEVICE=0

# Model Settings
MODEL_IDLE_TIMEOUT=600
ENABLE_MODEL_AUTO_UNLOAD=True

# PaddleOCR Features
USE_ANGLE_CLS=True
DET_DB_THRESH=0.3
USE_LAYOUT_DETECTION=True
USE_DOC_ORIENTATION=True
USE_DOC_UNWARPING=True

# API Settings
MAX_FILE_SIZE=10485760
MAX_BATCH_SIZE=10
REQUEST_TIMEOUT=30
MIN_CONFIDENCE=0.5

# Queue Management
ENABLE_REQUEST_QUEUE=True
MAX_CONCURRENT_REQUESTS=5
QUEUE_MAX_SIZE=50
QUEUE_TIMEOUT=60

# Output Settings
ENABLE_JSON_OUTPUT=True
ENABLE_MARKDOWN_OUTPUT=True

# Logging
LOG_LEVEL=INFO
ENABLE_METRICS_LOGGING=True

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
