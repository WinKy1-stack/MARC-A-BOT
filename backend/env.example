# ==========================================
# MARC-A-BOT Backend Configuration
# ==========================================
# Copy file này thành .env và điền các giá trị thực tế
# 
# Linux/macOS:
#   cp env.example .env
# 
# Windows PowerShell:
#   Copy-Item env.example .env
# 
# Windows CMD:
#   copy env.example .env

# ==========================================
# Flask Server Configuration
# ==========================================
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Server Settings
HOST=0.0.0.0
PORT=5001
DEBUG=True

# ==========================================
# OCR Configuration
# ==========================================
# GPU Settings
USE_GPU=True
GPU_MEM=500

# PaddleOCR Features
USE_LAYOUT_DETECTION=True
USE_DOC_ORIENTATION=True
USE_DOC_UNWARPING=True

# Processing Limits
MAX_FILE_SIZE=10485760
MAX_BATCH_SIZE=10
REQUEST_TIMEOUT=30
MIN_CONFIDENCE=0.5

# Output Format
ENABLE_JSON_OUTPUT=True
ENABLE_MARKDOWN_OUTPUT=True

# ==========================================
# Queue Configuration
# ==========================================
ENABLE_REQUEST_QUEUE=True
MAX_CONCURRENT_REQUESTS=5
QUEUE_MAX_SIZE=50
QUEUE_TIMEOUT=60

# ==========================================
# Model Auto-Unload
# ==========================================
ENABLE_MODEL_AUTO_UNLOAD=True
MODEL_IDLE_TIMEOUT=600

# ==========================================
# Agents Configuration
# ==========================================
# Gemini AI API Key (cho Agent 4 - Keywords & Authority Mapping)
# Lấy API key tại: https://makersuite.google.com/app/apikey
# Nếu không có API key, agents vẫn chạy được (rule-based)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Agent Settings
AGENT_TIMEOUT=30
AGENT_MAX_RETRIES=3

# Keyword Extraction
KEYWORD_MIN_SCORE=0.5
KEYWORD_MAX_COUNT=10

# Authority Service
AUTHORITY_SUBJECT_TYPE=general
AUTHORITY_USE_CACHE=True

# Agent Logging
AGENT_LOG_LEVEL=INFO

# ==========================================
# Authority Service Configuration (Agent 4)
# ==========================================
# Cache Settings
CACHE_DB_PATH=services/authority/cache/authority_cache.db

# API Rate Limits
API_RATE_LIMIT=100
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3

# Search/Matching
FUZZY_MATCH_THRESHOLD=80
MAX_SUGGESTIONS=10
CACHE_HIT_TARGET=0.80

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==========================================
# Hướng dẫn lấy Gemini API Key
# ==========================================
# 1. Truy cập: https://makersuite.google.com/app/apikey
# 2. Đăng nhập với Google account
# 3. Click "Create API Key"
# 4. Copy API key và dán vào GEMINI_API_KEY ở trên
#
# Lưu ý:
# - Nếu không có Gemini API key, hệ thống vẫn hoạt động bình thường
# - Agent 4 sẽ dùng rule-based keyword extraction thay vì AI
# - Authority mapping vẫn hoạt động với các nguồn LCSH/MeSH/LCC/NLM
#
# ==========================================
# Kiểm tra cấu hình
# ==========================================
# Sau khi tạo file .env, kiểm tra:
# python -c "from dotenv import load_dotenv; load_dotenv(); import os; print('GEMINI_API_KEY:', 'SET' if os.getenv('GEMINI_API_KEY') else 'NOT SET')"
#
# Validate agents config:
# python -c "from services.agents.config import validate_config; validate_config(); print('Config OK')"

